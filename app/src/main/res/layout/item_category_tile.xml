<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="146dp"
    android:background="@drawable/bg_sticky_note"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

    <TextView
        android:id="@+id/category_tile_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="#FF242127"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/category_tile_count"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:textColor="#99242127"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/category_tile_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingEnd="30dp"
        android:text="@string/open_sticky_category"
        android:textColor="#B3242127"
        android:textSize="11sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/category_tile_lock"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/private_notebook"
        android:src="@drawable/ic_lock"
        android:visibility="gone" />
</FrameLayout>
